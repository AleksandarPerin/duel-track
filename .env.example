NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://dueltrack:dueltrack_dev@localhost:5432/dueltrack
DATABASE_SSL=false
POOL_MAX=20

REDIS_URL=redis://localhost:6379

# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
JWT_ACCESS_EXPIRY_S=900         # 15 minutes
JWT_REFRESH_EXPIRY_S=604800      # 7 days

# Must be >= 12 per PRD security baseline
BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# Rate limits (requests per window)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=100
PUBLIC_RATE_LIMIT_WINDOW_MS=60000

VITE_API_URL=http://localhost:3000
